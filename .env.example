# You can generate a strong secret key using `openssl rand -hex 32`
GOVASSIST_AUTH_SECRET=your_super_secret_key_change_in_production
GOVASSIST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Optional: defaults to data/auth.db and is deliberately separate from RAG data.
# GOVASSIST_AUTH_DB=data/auth.db
